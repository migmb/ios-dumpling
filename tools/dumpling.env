# OnePlus 5T (dumpling), Qualcomm MSM8998. Source this from bash.
# Values verified against this unit's stock boot.img DTB (PVT blob,
# board-id 0x4589/0x2b); see docs/dumpling-deltas.md.

SOC=msm8998
FB_BASE=0x9d600000
FB_SIZE=0x02400000
FB_BLOCK=0x9c000000          # 32 MiB block that contains FB_BASE
FB_OFFSET=0x1600000          # FB_BASE - FB_BLOCK
FB_W=1080
FB_H=2160
FB_STRIDE=4320

GICD=0x17a00000
GICR=0x17b00000
GICR_STRIDE=0x10000          # MSM8998: contiguous 64K redistributor regions
VTIMER_INTID=19

UFS=0x1da4000
UFS_PHY=0x1da7000
PSHOLD=0x010ac000
IMEM_RESTART_REASON=0x1480f65c

# 6 or 8 GB LPDDR4X depending on the unit; the live FDT (supplied by ABL, the
# DTB has no memory nodes) is authoritative. Conservative stand-in until the
# shim prints the live dram map on first boot.
RAM_HIGH_BASE=0x100000000
RAM_HIGH_SIZE=0x17c000000

# This unit is dumpling v2.1 (qcom,msm-id 0x124/0x20001); the matching board
# DTB is the PVT blob (board-id ...,0x2b). DVT (...,0x2a) is the fallback.
DTB_DEFAULT=dtb/boot_unpacked/dumpling_pvt.dtb

# A53 MPIDR 0x000 0x100 0x200 0x300 (4K pages only, phase B)
# A73 MPIDR 0x400 0x500     (16K pages, phase A: what the ADT lists)
CPU_A53_FREQ=1939200000
CPU_A73_FREQ=2553600000

# Touch: Synaptics DSX/S3320 on classic (pre-GENI) QUP i2c5 @ 0xc179000, addr 0x20.
# reset gpio 89, irq gpio 125 (dumpling.dtsi). No GENI SE code applies.
TOUCH_I2C_BASE=0xc179000
TOUCH_I2C_ADDR=0x20
TOUCH_IRQ_GPIO=125
TOUCH_RESET_GPIO=89

# Keys: PM8998 (SPMI SID 0) PON at 0x800: kpdpwr + resin. Volume keys are
# not gpio-keys in the DTB; runtime discovery (tri-state key uses TLMM
# gpio 42/26/40).
VOL_DOWN_PMIC_GPIO=unknown
VOL_UP_PMIC_GPIO=unknown
