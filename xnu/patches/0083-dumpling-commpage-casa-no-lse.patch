diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -273,7 +273,16 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
-	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+	// dumpling (Cortex-A73, ARMv8.0): CASA as an LDAXR/STXR loop, w10 = old value.
+	// The kernel is built -mcpu=cortex-a73; clang's cortex-a73 target does not
+	// enable LSE, and the iPhone X userland predates it anyway.
+1:	ldaxr	w10, [x3]
+	cbnz	w10, 2f
+	stxr	w12, w11, [x3]
+	cbnz	w12, 1b
+	b	3f
+2:	clrex
+3:
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,7 +330,14 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
-	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+	// dumpling (ARMv8.0): same LDAXR/STXR CAS loop, w10 = old value
+1:	ldaxr	w10, [x2]
+	cbnz	w10, 2f
+	stxr	w12, w11, [x2]
+	cbnz	w12, 1b
+	b	3f
+2:	clrex
+3:
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
